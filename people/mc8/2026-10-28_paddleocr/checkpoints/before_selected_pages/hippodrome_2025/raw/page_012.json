      },
      {
        "block_label": "table",
        "block_content": "<html><body><table><tr><td>w E g3 08913 W8013 WL23 JA onn</td><td>9 202 OS3 apun suasno</td></tr></table></body></html>",
        "block_bbox": [
          315,
          787,
          1786,
