    "parsing_res_list": [
      {
        "block_label": "doc_title",
        "block_content": "HIPPODROME CASINO LIMITED  DIRECTORS'RESPONSIBILITIES STATEMENT  FOR THE YEAR ENDED 31 DECEMBER 2025",
        "block_bbox": [
          255,
          288,
          1307,
          547
        ],
        "block_id": 0,
        "block_order": 1
      },
      {
        "block_label": "text",
        "block_content": "The directors are responsible for preparing the Strategic Report and the Directors' Report and the financial statements in accordance with applicable law and regulations.\n",
        "block_bbox": [
          252,
          657,
          2204,
          738
        ],
        "block_id": 1,
        "block_order": 2
      },
      {
        "block_label": "text",
        "block_content": "Company law requires the directors to prepare financial statements for each financial year. Under that law the directors have elected to prepare the financial statements in accordance with United Kingdom Generally Accepted Accounting Practice (United Kingdom Accounting Standards and applicable law). Under company law the directors must not approve the financial statements unless they are satisfied that they give a true and fair view of the state of affairs of the company and of the profit or loss of the company for that period. In preparing these financial statements, the directors are required to:",
        "block_bbox": [
          252,
          787,
          2204,
          1041
        ],
        "block_id": 2,
        "block_order": 3
      },
      {
        "block_label": "text",
        "block_content": "• select suitable accounting policies and then apply them consistently;",
        "block_bbox": [
          289,
          1090,
          1485,
          1124
        ],
        "block_id": 3,
        "block_order": 4
      },
      {
        "block_label": "text",
        "block_content": "• make judgements and accounting estimates that are reasonable and prudent;",
        "block_bbox": [
          289,
          1133,
          1636,
          1169
        ],
        "block_id": 4,
        "block_order": 5
      },
      {
        "block_label": "text",
        "block_content": "• state whether applicable UK Accounting Standards have been followed, subject to any material departures disclosed and explained in the financial statements; and ",
        "block_bbox": [
          289,
          1176,
          2205,
          1254
        ],
        "block_id": 5,
        "block_order": 6
      },
      {
        "block_label": "text",
        "block_content": "• prepare the financial statements on the going concern basis unless it is inappropriate to presume that the company will continue in business.\n",
        "block_bbox": [
          289,
          1262,
          2205,
          1342
        ],
        "block_id": 6,
        "block_order": 7
      },
      {
        "block_label": "text",
        "block_content": "The directors are responsible for keeping adequate accounting records that are sufficient to show and explain the company's transactions and disclose with reasonable accuracy at any time the financial position of the company and enable them to ensure that the financial statements comply with the Companies Act 2o06. They are also responsible for safeguarding the assets of the company and hence for taking reasonable steps for the prevention and detection of fraud and other irregularities.\n",
        "block_bbox": [
          251,
          1388,
          2205,
          1597
        ],
        "block_id": 7,
        "block_order": 8
      },
      {
        "block_label": "number",
        "block_content": "-14",
        "block_bbox": [
          1192,
