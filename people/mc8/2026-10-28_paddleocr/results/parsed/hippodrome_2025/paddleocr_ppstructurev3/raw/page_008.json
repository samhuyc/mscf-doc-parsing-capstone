    "parsing_res_list": [
      {
        "block_label": "doc_title",
        "block_content": "HIPPODROME CASINO LIMITED ",
        "block_bbox": [
          265,
          290,
          1120,
          340
        ],
        "block_id": 0,
        "block_order": 1
      },
      {
        "block_label": "paragraph_title",
        "block_content": "STRATEGIC REPORT (CONTINUED)FOR THE YEAR ENDED 31 DECEMBER 2025",
        "block_bbox": [
          262,
          415,
          1279,
          544
        ],
        "block_id": 1,
        "block_order": 2
      },
      {
        "block_label": "text",
        "block_content": "• Gambling Ombudsman - The Government has committed to the establishment of an independent Gambling Ombudsman to handle disputes between customers and operators and provide redress where appropriate. Implementation remains subject to further legislative and operational development.",
        "block_bbox": [
          367,
          658,
          2204,
          780
        ],
        "block_id": 2,
        "block_order": 3
      },
      {
        "block_label": "text",
        "block_content": "Gaming Machine Allowances and Land-Based Casino Reforms - The Government has progressed a number of reforms affecting the land-based casino sector, including changes to gaming machine entitlements and measures intended to modernise the regulatory framework. Certain elements remain subject to ongoing implementation and commencement arrangements.\n",
        "block_bbox": [
          367,
          790,
          2204,
          952
        ],
        "block_id": 3,
        "block_order": 4
      },
      {
        "block_label": "text",
        "block_content": "Player Protections – The Gambling Commission has introduced, and continues to develop, a range of customer protection measures arising from the White Paper, including financial risk assessments,enhanced consumer information requirements and other safeguards designed to reduce gambling-related harm.\n",
        "block_bbox": [
          367,
          961,
          2206,
          1121
        ],
        "block_id": 4,
        "block_order": 5
      },
      {
        "block_label": "text",
        "block_content": " Local Authority Premises Licence Fees - The Government has reviewed the fee caps applicable to premises licences issued by local authorities, with implementation of any revised arrangements subject to the relevant legislative and administrative processes.\n",
        "block_bbox": [
          368,
          1133,
          2203,
          1255
        ],
        "block_id": 5,
        "block_order": 6
      },
      {
        "block_label": "text",
        "block_content": "The Group continues to monitor regulatory developments and implementation guidance issued by the Gambling Commission and other relevant authorities and is working to ensure ongoing compliance with applicable requirements.\n",
        "block_bbox": [
          260,
          1304,
          2202,
          1426
        ],
        "block_id": 6,
        "block_order": 7
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Capital Investment at The Hippodrome Casino ",
        "block_bbox": [
          263,
          1475,
          1098,
          1513
        ],
        "block_id": 7,
        "block_order": 8
      },
      {
        "block_label": "text",
        "block_content": "We continue to invest in creating exceptional spaces for our customers to enjoy with the introduction of Paddy's Sportsbook and our new Slots Lounge in 2025. As we look ahead, we expect to maintain our progress and keep investing selectively across the business. Our investment decisions are driven by a combination of key drivers:customer experience and choice, safety and compliance, property stewardship, efficiency and revenue growth.",
        "block_bbox": [
          260,
          1562,
          2202,
          1729
        ],
        "block_id": 8,
        "block_order": 9
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Our Core Purpose ",
        "block_bbox": [
          265,
          1779,
          596,
          1813
        ],
        "block_id": 9,
        "block_order": 10
      },
      {
        "block_label": "text",
        "block_content": "The Hippodrome exists to·fulfil the needs of our customers by delivering an experience unmatched by any other business around the world. Customers are at the centre of everything we do. We are a casino based entertainment complex that aims to Surprise, Amaze, make Memorable and Entertain. Defined as S.A.M.E this is applied to and integrated with every aspect of the Hippodrome business, every day, to world class standards.",
        "block_bbox": [
          245,
          1863,
          2204,
          2030
        ],
        "block_id": 10,
        "block_order": 11
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Our Fundamental Principles ",
        "block_bbox": [
          263,
          2078,
          774,
          2114
        ],
        "block_id": 11,
        "block_order": 12
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Freedom ",
        "block_bbox": [
          315,
          2165,
          587,
          2198
        ],
        "block_id": 12,
        "block_order": 13
      },
      {
        "block_label": "text",
        "block_content": "We value individual freedom above all else. No one has the night to tell another how to be or act.",
        "block_bbox": [
          262,
          2207,
          1877,
          2242
        ],
        "block_id": 13,
        "block_order": 14
      },
      {
        "block_label": "paragraph_title",
        "block_content": "2Eguality & Eguity ",
        "block_bbox": [
          314,
          2295,
          738,
          2330
        ],
        "block_id": 14,
        "block_order": 15
      },
      {
        "block_label": "text",
        "block_content": "We are all equal and equal in all things, regardless of gender, race, religion, language, family or any other matters.",
        "block_bbox": [
          264,
          2337,
          2175,
          2375
        ],
        "block_id": 15,
        "block_order": 16
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Community ",
        "block_bbox": [
          315,
          2424,
          635,
          2458
        ],
        "block_id": 16,
        "block_order": 17
      },
      {
        "block_label": "text",
        "block_content": "We build and participate in communities to enrich lives, provide for the needs of our associates, and keep them safe from ham.\n",
        "block_bbox": [
          262,
          2466,
          2202,
          2543
        ],
        "block_id": 17,
        "block_order": 18
      },
      {
        "block_label": "text",
        "block_content": "Underpinning our Fundamental Principles is a strengthened focus and investment on simplifying the customer  journey through the various elements of the Hippodrome, ensuring an easy and above all enjoyable experience.",
        "block_bbox": [
          260,
          2594,
          2201,
          2676
        ],
        "block_id": 18,
        "block_order": 19
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Our Shared Values ",
        "block_bbox": [
          265,
          2724,
          607,
          2757
        ],
        "block_id": 19,
        "block_order": 20
      },
      {
        "block_label": "text",
        "block_content": "Our Shared Values support our strategy. They represent what we believe in and who we aspire to be. It's not just what we achieve, but how we work together, that sets us apart. Guided by our values, we'll make the Hippodrome an even better place to visit and work.\n",
        "block_bbox": [
          261,
          2810,
          2202,
          2934
        ],
        "block_id": 20,
        "block_order": 21
      },
      {
        "block_label": "number",
        "block_content": "-6",
        "block_bbox": [
          1209,
          3316,
          1271,
          3343
        ],
        "block_id": 21,
        "block_order": 22
      }
    ],
