    "parsing_res_list": [
      {
        "block_label": "doc_title",
        "block_content": "HIPPODROME CASINO LIMITED ",
        "block_bbox": [
          256,
          283,
          1117,
          333
        ],
        "block_id": 0,
        "block_order": 1
      },
      {
        "block_label": "paragraph_title",
        "block_content": "DIRECTORS'REPORT FOR THE YEAR ENDED 31 DECEMBER 2025",
        "block_bbox": [
          254,
          411,
          1275,
          540
        ],
        "block_id": 1,
        "block_order": 2
      },
      {
        "block_label": "text",
        "block_content": "The directors present their annual report and financial statements for the year ended 31 December 2025",
        "block_bbox": [
          255,
          653,
          2022,
          691
        ],
        "block_id": 2,
        "block_order": 3
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Principal activities ",
        "block_bbox": [
          255,
          752,
          600,
          788
        ],
        "block_id": 3,
        "block_order": 4
      },
      {
        "block_label": "text",
        "block_content": "The principal activity of the Company continued to be that of a gaming and entertainment establishment.",
        "block_bbox": [
          256,
          801,
          2009,
          841
        ],
        "block_id": 4,
        "block_order": 5
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Directors ",
        "block_bbox": [
          255,
          902,
          434,
          936
        ],
        "block_id": 5,
        "block_order": 6
      },
      {
        "block_label": "text",
        "block_content": "The directors who held office during the year and up to the date of signature of the financial statements were as follows:",
        "block_bbox": [
          252,
          949,
          2207,
          1030
        ],
        "block_id": 6,
        "block_order": 7
      },
      {
        "block_label": "text",
        "block_content": "Mr J S Thomas \nMr M King \n\nMr J C Barnsley \nMr JR Delf \nMr T Bowry-Blum \nMr D C AAddenbrooke \nMr P I Lewis \nMr RA Bangs \n",
        "block_bbox": [
          253,
          1092,
          648,
          1476
        ],
        "block_id": 7,
        "block_order": 8
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Results and dividends ",
        "block_bbox": [
          255,
          1538,
          670,
          1573
        ],
        "block_id": 8,
        "block_order": 9
      },
      {
        "block_label": "text",
        "block_content": "The results for the year are set out on page 18.",
        "block_bbox": [
          257,
          1587,
          1056,
          1627
        ],
        "block_id": 9,
        "block_order": 10
      },
      {
        "block_label": "text",
        "block_content": "(Resigned 3 October 2025)",
        "block_bbox": [
          1123,
          1339,
          1584,
          1378
        ],
        "block_id": 10,
        "block_order": 11
      },
      {
        "block_label": "text",
        "block_content": "(Appointed 1 June 2025)",
        "block_bbox": [
          1123,
          1439,
          1543,
          1479
        ],
        "block_id": 11,
        "block_order": 12
      },
      {
        "block_label": "text",
        "block_content": "No ordinary or preference share dividends were paid in the year (2024: £Nil). The directors do not recommend payment of any final ordinary or preference share dividends (2o24: ENil).\n",
        "block_bbox": [
          252,
          1685,
          2206,
          1768
        ],
        "block_id": 12,
        "block_order": 13
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Qualifying third party indemnity provisions ",
        "block_bbox": [
          255,
          1827,
          1043,
          1864
        ],
        "block_id": 13,
        "block_order": 14
      },
      {
        "block_label": "text",
        "block_content": "The Company has made qualifying third party indemnity provisions for the benefit of its directors during the year.These provisions remain in force at the reporting date \n",
        "block_bbox": [
          254,
          1876,
          2204,
          1959
        ],
        "block_id": 14,
        "block_order": 15
      },
      {
        "block_label": "paragraph_title",
        "block_content": "Disabled persons ",
        "block_bbox": [
          255,
          2020,
          583,
          2053
        ],
        "block_id": 15,
        "block_order": 16
      },
      {
        "block_label": "text",
        "block_content": "The Hippodrome's aim is to ensure that all employees and job applicants are given equal opportunity and that we represent our customer base, Stakeholders and wider local community. In accordance with our ED&l policy,candidates are selected for employment, promotion or training on the basis of their merit, regardless of age, gender,gender identity, race, religion, sexual orientation, disability, marital status or maternity and pregnancy.",
        "block_bbox": [
          251,
          2066,
          2206,
          2236
        ],
        "block_id": 16,
        "block_order": 17
      },
      {
        "block_label": "text",
        "block_content": "Disabled people are encouraged to apply and progress their career with us. We see people for their abilities, not their disabilities. Adjustments are made for job applicants and employees to guarantee we're breaking or minimising any barriers to·their development.\n",
        "block_bbox": [
          251,
          2283,
          2207,
          2409
        ],
        "block_id": 17,
        "block_order": 18
      },
      {
        "block_label": "text",
        "block_content": "Our policies are continuously being reviewed to ensure we're an inclusive and accessible employer.",
        "block_bbox": [
          253,
          2457,
          1931,
          2495
        ],
        "block_id": 18,
        "block_order": 19
      },
      {
        "block_label": "text",
        "block_content": "All employees will be given help and encouragement to develop their full potential and use their unique talents.Therefore, the skills and resources of the Hippodrome will be fully used to maximise the efficiency of the whole workforce.\n",
        "block_bbox": [
          250,
          2544,
          2205,
          2666
        ],
        "block_id": 19,
        "block_order": 20
      },
      {
        "block_label": "text",
        "block_content": "All employees, no matter whether they are part-time, full-time, or temporary, will be treated fairly and with respect.This policy is adopted throughout the Hippodrome in relation to all recruitment and to succession planning, to support a diverse pipeline.\n",
        "block_bbox": [
          250,
          2717,
          2205,
          2843
        ],
        "block_id": 20,
        "block_order": 21
      },
      {
        "block_label": "number",
        "block_content": "- 11",
        "block_bbox": [
          1192,
          3325,
          1277,
          3355
        ],
        "block_id": 21,
        "block_order": 22
      }
    ],
