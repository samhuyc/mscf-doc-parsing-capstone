        ],
        "block_id": 1,
        "block_order": 2
      },
      {
        "block_label": "text",
        "block_content": "The directors consider that the company is entitled to exemption from audit under section 477 of the Companies Act 2006 and members have not required the company to obtain an audit for the year in question in accordance with section 476 of the Companies Act 2006.\n",
        "block_bbox": [
          171,
          594,
          2295,
          721
        ],
        "block_id": 2,
        "block_order": 3
      },
      {
        "block_label": "text",
        "block_content": "The directors acknowledge their responsibilities for complying with the requirements of the Companies Act 20o6 with respect to accounting records and the preparation of financial statements.\n",
        "block_bbox": [
          172,
          782,
          2294,
          866
        ],
        "block_id": 3,
        "block_order": 4
      },
      {
        "block_label": "text",
        "block_content": "The financial statements have been prepared in accordance with the provisions applicable to companies subject to the small companies regime and in accordance with the provisions of FRS 102 Section 1A - small entities.",
        "block_bbox": [
          173,
          924,
          2296,
          1008
        ],
        "block_id": 4,
        "block_order": 5
      },
      {
        "block_label": "text",
        "block_content": "The financial statements have been delivered in accordance with the provisions applicable to companies subject to the small companies regime.\n",
        "block_bbox": [
          173,
          1066,
          2294,
          1149
        ],
        "block_id": 5,
        "block_order": 6
      },
      {
        "block_label": "text",
        "block_content": "The company has opted not to file the statement of comprehensive income in accordance with provisions applicable to companies subject to the small companies'regime.\n",
        "block_bbox": [
          172,
          1207,
          2294,
          1290
        ],
        "block_id": 6,
        "block_order": 7
      },
      {
        "block_label": "text",
        "block_content": "The financial statements were approved and authorised for issue by the board and were signed on its behalf by:",
        "block_bbox": [
          176,
          1350,
          1930,
          1386
        ],
        "block_id": 7,
        "block_order": 8
      },
      {
        "block_label": "text",
